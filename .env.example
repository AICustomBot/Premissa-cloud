# PERMISSA environment reference.
#
# Canonical deployment target (frozen):
#   GCP project        : aicustombot
#   Region             : us-central1
#   Firestore database : premissadb
#
# Secrets are intentionally left blank. Never commit real values, and never
# set them as literal Cloud Run env vars -- use Secret Manager references.
# See docs/DEPLOYMENT-RUNBOOK.md.

# --- Runtime mode -----------------------------------------------------------
# Must be spelled exactly NODE_ENV. A misspelling (e.g. NOD_ENV) silently
# re-enables the dev-token auth path.
NODE_ENV=production

# Belt-and-braces for the above: explicitly refuse dev tokens in production.
PERMISSA_ALLOW_DEV_TOKENS=false

# Refuse to boot rather than fall back to the in-memory store, which loses all
# data when Cloud Run scales to zero.
PERMISSA_REQUIRE_DURABLE_STORE=true

# --- Google Cloud identity --------------------------------------------------
# FirestoreService reads FIRESTORE_PROJECT_ID, then GCP_PROJECT, then
# GOOGLE_CLOUD_PROJECT. Cloud Run does not set GOOGLE_CLOUD_PROJECT, so
# FIRESTORE_PROJECT_ID must be set explicitly.
FIRESTORE_PROJECT_ID=aicustombot

# Named database, not (default). Must match the database key in firebase.json,
# or rules deploy to one database while the app reads another.
FIRESTORE_DATABASE_ID=premissadb

# Read by infra/deploy tooling rather than FirestoreService. Kept for parity.
GCP_PROJECT_ID=aicustombot
FIREBASE_PROJECT_ID=aicustombot

GCP_REGION=us-central1
VERTEX_LOCATION=us-central1

# --- Firebase Admin credentials (secret) ------------------------------------
# Omit both on Cloud Run: the service account provides Application Default
# Credentials. Only needed for local development.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Storage ----------------------------------------------------------------
GCS_UPLOAD_BUCKET=
GCS_REPORT_BUCKET=

# --- Async execution --------------------------------------------------------
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_COORDINATOR_URL=

# --- Gemini -----------------------------------------------------------------
GEMINI_ENABLED=true
GEMINI_MODEL_FAST=
GEMINI_MODEL_STRONG=
# Secret. Secret Manager reference only. Never in a client bundle.
GEMINI_API_KEY=

# --- Parallel Search (mandatory partner track) ------------------------------
PARALLEL_ENABLED=true
# Secret. Secret Manager reference only.
PARALLEL_API_KEY=

# --- Observability ----------------------------------------------------------
GRAFANA_MCP_ENABLED=false
GRAFANA_MCP_URL=
# Secret. Secret Manager reference only.
GRAFANA_MCP_TOKEN=

# --- Frozen policy caps -----------------------------------------------------
RUN_ENTITY_CAP=50
RUN_PARALLEL_CALL_CAP=50
ENTITY_PARALLEL_CALL_CAP=3
RUN_DEADLINE_SECONDS=600
RUN_COST_CAP_USD=10.00
AGGREGATE_PREDEMO_CAP_USD=80
MAX_CONCURRENT_RUNS=1
USER_DAILY_RUN_LIMIT=3
GLOBAL_DAILY_RUN_LIMIT=25
PLATFORM_ADMIN_ALLOWLIST=

# --- Operator console (Vite, build time) ------------------------------------
# Baked into the client bundle at build time. Must never hold a secret.
# This is the ONLY variable the AI Studio applet needs.
VITE_API_BASE_URL=
