# Dashboard image: the apps/web Next.js app for the permissa-web Cloud Run
# service. The console has its own Dockerfile.console; the two services are
# built and deployed independently so neither can roll the other back.
#
# The whole repository is copied into the build stage deliberately. This is an
# npm workspace root with a committed lockfile, and the lockfile describes
# every workspace in the repo. Copying only apps/web plus the two packages it
# imports leaves the install resolving manifests for directories that are not
# in the build context, which fails rather than pruning. A slightly larger
# build context is worth far more than a fragile install.
FROM node:20-slim AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

COPY . .

# install, not ci: the lockfile is new and the workspace graph is still
# settling. Switch to `npm ci` once P0-2 is closed and the lockfile is known
# to be in sync, so builds become reproducible.
RUN npm install --no-audit --no-fund

# The dashboard imports the shared contracts and policy packages, which are
# consumed as built output rather than source, so they are built first.
RUN npm run build --workspace=@permissa/contracts \
 && npm run build --workspace=@permissa/policy \
 && npm run build --workspace=@permissa/web

# apps/web/next.config.mjs sets output: "standalone" with the monorepo tracing
# root, so the server lands at apps/web/.next/standalone/apps/web/server.js.
# Asserting it exists turns a silent config regression into a failed build
# instead of a container that exits immediately on Cloud Run.
RUN test -f apps/web/.next/standalone/apps/web/server.js \
 || (echo "next build did not produce the standalone server at apps/web/.next/standalone/apps/web/server.js" >&2 && exit 1)

# The dashboard receives its Firebase web config at runtime from /api/config,
# so no credential-shaped value should ever be baked into the client bundle.
# This is the same gate the console image applies.
RUN if grep -rIlE '(AIza[0-9A-Za-z_-]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(PARALLEL|GRAFANA|GEMINI)_[A-Z_]*(KEY|TOKEN)"?[:=][^,}]{12,})' apps/web/.next/static; then \
      echo "A credential-shaped value is present in the client bundle. Runtime configuration must be served from /api/config, never compiled in." >&2; \
      exit 1; \
    fi

# Runtime stage. Only the standalone server and static assets cross over, so
# the repository, the lockfile, and every devDependency stay in the build
# stage.
FROM node:20-slim
ENV NODE_ENV=production \
    PORT=8080 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# Runs unprivileged: nothing in the dashboard needs root, and Cloud Run does
# not require it.
RUN useradd --uid 10001 --create-home permissa

COPY --from=build --chown=permissa:permissa /app/apps/web/.next/standalone ./
COPY --from=build --chown=permissa:permissa /app/apps/web/.next/static ./apps/web/.next/static

USER permissa
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
