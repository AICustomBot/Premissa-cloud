# syntax=docker/dockerfile:1

# PERMISSA web dashboard image (apps/web, Next.js).
#
# Mirrors the console topology deliberately: built by Cloud Build, run on
# Cloud Run, and carrying no credentials of any kind. The Firebase web config
# and the API origin arrive at runtime through the /api/config route handler
# (PERMISSA_* environment variables), not at build time, so nothing
# credential-shaped is baked into the client bundle.
#
# Monorepo build: apps/web imports the workspace packages @permissa/contracts
# and @permissa/policy, so the build context is the repository root and those
# packages are compiled before the Next.js build.

FROM node:20-slim AS build
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# package*.json is a glob deliberately: this repository has no committed root
# lockfile yet (P0-2 tracks it), and the glob picks one up automatically once
# it lands.
COPY package*.json tsconfig.base.json ./
COPY packages/contracts ./packages/contracts
COPY packages/policy ./packages/policy
COPY apps/web ./apps/web

# npm install rather than npm ci: no committed lockfile. Same choice as
# Dockerfile.console and apps/api/Dockerfile.
RUN npm install --no-audit --no-fund

# Workspace libraries must be built before Next.js: their package.json entry
# points resolve to dist/, and policy depends on the contracts build.
RUN npm run build --workspace=@permissa/contracts
RUN npm run build --workspace=@permissa/policy
RUN npm run build --workspace=@permissa/web

# With experimental.outputFileTracingRoot set to the repository root, the
# standalone server lands at apps/web/server.js inside the output.
RUN test -f apps/web/.next/standalone/apps/web/server.js \
 || (echo "next build did not produce the standalone server" >&2 && exit 1)

# Last line of defence for the no-secrets-in-client-bundles rule, same pattern
# as Dockerfile.console: a Google API key, a PEM, or a provider token literal
# in the client assets fails the build instead of reaching a public URL.
RUN if grep -rIlE '(AIza[0-9A-Za-z_-]{30,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(PARALLEL|GRAFANA|GEMINI)_[A-Z_]*(KEY|TOKEN)"?[:=][^,}]{12,})' apps/web/.next/static; then \
      echo "A credential-shaped value is present in the client bundle." >&2; \
      exit 1; \
    fi

FROM node:20-slim
ENV NODE_ENV=production
ENV PORT=8080
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
RUN useradd --uid 10001 --create-home permissa

# The standalone output already contains the traced node_modules it needs;
# .next/static is not traced and must be copied beside the server.
COPY --from=build --chown=permissa:permissa /app/apps/web/.next/standalone ./
COPY --from=build --chown=permissa:permissa /app/apps/web/.next/static ./apps/web/.next/static

USER permissa
EXPOSE 8080
CMD ["node", "apps/web/server.js"]
