{
  "name": "permissa",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "NODE_ENV=production npm run build --workspace=apps/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contracts:generate": "npm run generate --workspace=@permissa/contracts",
    "contracts:check": "npm run check --workspace=@permissa/contracts",
    "e2e": "npm run e2e --workspace=@permissa/web"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}