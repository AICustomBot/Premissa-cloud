        "reachable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "taskId",
        "originalUrl",
        "resolvedUrl",
        "resolvedDomain",
        "controllingOwner",
        "title",
        "excerpt",
        "sourceTier",
        "claimType",
        "query",
        "publishedAt",
        "updatedAt",
        "retrievedAt",
