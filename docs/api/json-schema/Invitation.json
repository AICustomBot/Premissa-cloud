{
  "$ref": "#/definitions/Invitation",
  "definitions": {
    "Invitation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "reviewerEmailNormalized": {
          "type": "string",
          "format": "email"
        },
        "state": {
          "type": "string",
          "enum": [
            "ISSUED",
            "ACCEPTED",
            "EXPIRED",
            "REVOKED"
          ]
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "projectId",
        "reviewerEmailNormalized",
        "state",
        "expiresAt",
        "acceptUrl"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
