{
  "$ref": "#/definitions/Finding",
  "definitions": {
    "Finding": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "$ref": "#/definitions/Finding/properties/createdAt"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "runId": {
          "$ref": "#/definitions/Finding/properties/id"
        },
        "entityId": {
          "$ref": "#/definitions/Finding/properties/id"
        },
        "proposedStatus": {
          "type": "string",
          "enum": [
            "RESEARCH_CLEARED",
            "NEEDS_LICENCE",
            "NEEDS_REWRITE",
            "BLOCKED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "admittedStatus": {
          "$ref": "#/definitions/Finding/properties/proposedStatus"
        },
        "professionalConfirmationRequired": {
          "type": "boolean"
        },
        "confidence": {
          "type": "object",
          "properties": {
            "formulaVersion": {
              "type": "string"
            },
            "rawScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "finalScore": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "band": {
              "type": "string",
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            },
            "factors": {
              "type": "object",
              "properties": {
                "authority": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40
                },
                "independence": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "entityMatch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "freshness": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "context": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              },
              "required": [
                "authority",
                "independence",
                "entityMatch",
                "freshness",
                "context"
              ],
              "additionalProperties": false
            },
            "caps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "invalidations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reasonCodes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "EVIDENCE_MISSING",
                  "EVIDENCE_WEAK",
                  "EVIDENCE_CONFLICT",
                  "EVIDENCE_EXPIRED",
                  "EVIDENCE_NOT_INDEPENDENT",
                  "ENTITY_MATCH_WEAK",
                  "CONTEXT_INCOMPLETE",
                  "SOURCE_TIER_INSUFFICIENT",
                  "BUDGET_LIMIT",
                  "PROVIDER_FAILED",
                  "LICENCE_SIGNAL_SUPPORTED",
                  "REWRITE_PATH_SUPPORTED",
                  "STRONG_CONFLICT",
                  "SEVERE_CONTEXT",
                  "PROFESSIONAL_CONFIRMATION_REQUIRED",
                  "PUBLICATION_DATE_UNKNOWN",
                  "CITATION_UNREACHABLE",
                  "RETRIEVAL_AGE_EXCEEDED",
                  "REGISTRY_REFRESH_REQUIRED",
                  "CURRENT_SOURCE_TOO_OLD",
                  "HISTORICAL_PRIMARY_ACCEPTED",
                  "DISCOVERY_SOURCE_ONLY",
                  "CONFIDENCE_BELOW_CLEARED_THRESHOLD"
                ]
              }
            }
          },
          "required": [
            "formulaVersion",
            "rawScore",
            "finalScore",
            "band",
            "factors",
            "caps",
            "invalidations",
            "reasonCodes"
          ],
          "additionalProperties": false
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding/properties/confidence/properties/reasonCodes/items"
          }
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        },
        "rewriteSuggestion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 600
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "createdAt",
        "updatedAt",
        "id",
        "runId",
        "entityId",
        "proposedStatus",
        "admittedStatus",
        "professionalConfirmationRequired",
        "confidence",
        "reasonCodes",
        "rationale",
        "rewriteSuggestion"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
