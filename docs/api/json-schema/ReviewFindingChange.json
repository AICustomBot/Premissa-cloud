{
  "$ref": "#/definitions/ReviewFindingChange",
  "definitions": {
    "ReviewFindingChange": {
      "type": "object",
      "properties": {
        "findingId": {
          "type": "string",
          "format": "uuid"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 0
        },
        "newStatus": {
          "type": "string",
          "enum": [
            "RESEARCH_CLEARED",
            "NEEDS_LICENCE",
            "NEEDS_REWRITE",
            "BLOCKED",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "addedCitationUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "maxItems": 10,
          "default": []
        }
      },
      "required": [
        "findingId",
        "expectedVersion",
        "newStatus",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
