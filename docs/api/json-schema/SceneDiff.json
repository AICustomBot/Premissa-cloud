{
  "$ref": "#/definitions/SceneDiff",
  "definitions": {
    "SceneDiff": {
      "type": "object",
      "properties": {
        "sceneNumber": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "changeType": {
          "type": "string",
          "enum": [
            "ADDED",
            "MODIFIED",
            "DELETED",
            "UNTOUCHED"
          ]
        },
        "baseSceneId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetSceneId": {
          "anyOf": [
            {
              "$ref": "#/definitions/SceneDiff/properties/baseSceneId/anyOf/0"
            },
            {
              "type": "null"
            }
          ]
        },
        "addedLinesCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "removedLinesCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "modifiedLinesCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "diffDetails": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "heading",
        "changeType"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
