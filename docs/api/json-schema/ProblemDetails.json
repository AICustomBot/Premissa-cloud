{
  "$ref": "#/definitions/ProblemDetails",
  "definitions": {
    "ProblemDetails": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string"
        },
        "instance": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "enum": [
            "AUTH_REQUIRED",
            "FORBIDDEN",
            "UPLOAD_EXPIRED",
            "FILE_TYPE_INVALID",
            "FILE_SIGNATURE_INVALID",
            "PAGE_LIMIT_EXCEEDED",
            "PDF_LOCKED",
            "FDX_PARSE_FAILED",
            "ENTITY_REGISTER_UNCONFIRMED",
            "ENTITY_LIMIT_EXCEEDED",
            "RUN_ALREADY_ACTIVE",
            "RUN_QUOTA_EXCEEDED",
            "GEMINI_UNAVAILABLE",
            "PARALLEL_UNAVAILABLE",
            "GRAFANA_DEGRADED",
            "PREFLIGHT_BLOCKED",
            "EVIDENCE_INSUFFICIENT",
            "EVIDENCE_CONFLICT",
            "BUDGET_EXCEEDED",
            "RUN_TIMEOUT",
            "INVALID_STATE_TRANSITION",
            "VERSION_CONFLICT",
            "CURSOR_INVALID",
            "VALIDATION_FAILED"
          ]
        },
        "correlationId": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "code",
        "correlationId",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
