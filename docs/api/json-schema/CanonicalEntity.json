{
  "$ref": "#/definitions/CanonicalEntity",
  "definitions": {
    "CanonicalEntity": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "$ref": "#/definitions/CanonicalEntity/properties/createdAt"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scriptVersionId": {
          "$ref": "#/definitions/CanonicalEntity/properties/id"
        },
        "type": {
          "type": "string",
          "enum": [
            "PERSON_CHARACTER",
            "BRAND_BUSINESS_PRODUCT",
            "PRODUCTION_TITLE"
          ]
        },
        "canonicalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 20
        },
        "mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sceneId": {
                "$ref": "#/definitions/CanonicalEntity/properties/id"
              },
              "sourceRange": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "integer"
                  },
                  "end": {
                    "type": "integer"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              },
              "contextExcerpt": {
                "type": "string",
                "maxLength": 600
              }
            },
            "required": [
              "sceneId",
              "sourceRange",
              "contextExcerpt"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "createdAt",
        "updatedAt",
        "id",
        "scriptVersionId",
        "type",
        "canonicalName",
        "aliases",
        "mentions",
        "confirmed"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
