rules_version = '2';

// PERMISSA Firestore security rules.
//
// This is the single canonical rules file for the project. Privileged writes
// (entity register creation, research findings, clearance status assignment,
// budget accounting and audit records) are performed by the API and job service
// identities through the Firebase Admin SDK, which bypasses these rules
// entirely. Everything a browser is permitted to do is enumerated below and
// nothing else is allowed.
//
// These rules enforce the seven data invariants and block all twelve threat
// payloads in /security_spec.md. The executable proof lives in
// packages/security-rules/test/firestore-rules.spec.ts.
//
// Note on rule evaluation: Firestore evaluates every matching rule and grants
// access if ANY of them allows it. A leading `allow read, write: if false`
// block therefore denies nothing. Deny-by-default is expressed by the absence
// of an allow rule, and the terminal catch-all at the bottom of this file is
// documentation of that fact rather than an enforcement mechanism.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Administrator status is granted only by an /admins/{uid} document, which
    // is writable exclusively by the Admin SDK. No address is hardcoded here.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string &&
        id.size() > 0 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function changed() {
      return incoming().diff(existing()).affectedKeys();
    }

    // Invariant 7. The client may not choose its own audit timestamp, so
    // updatedAt must be a server timestamp. Clients must send
    // serverTimestamp(); an ISO string is rejected.
    function stampedNow() {
      return incoming().updatedAt is timestamp &&
        incoming().updatedAt == request.time;
    }

    // ------------------------------------------------- caller profile / tenant

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    function isMemberOf(orgId) {
      return hasProfile() && profile().organizationId == orgId;
    }

    function isProducer() {
      return hasProfile() && profile().role == 'PRODUCER';
    }

    function isReviewer() {
      return hasProfile() && profile().role == 'REVIEWER';
    }

    function isOrgOwner() {
      return hasProfile() && profile().role == 'OWNER';
    }

    // --------------------------------------------------------------- /admins

    match /admins/{adminId} {
      allow get: if isSelf(adminId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------- /users

    function isValidUserProfile(data) {
      return data.keys().hasAll(
          ['id', 'name', 'email', 'role', 'organizationId', 'createdAt', 'updatedAt']) &&
        data.id is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        data.role in ['PRODUCER', 'REVIEWER', 'OWNER'] &&
        isValidId(data.organizationId) &&
        data.get('organizationName', '') is string &&
        data.get('organizationName', '').size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isSelf(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == userId &&
        incoming().createdAt == request.time &&
        stampedNow();

      // role and organizationId are assigned out of band by an administrator
      // or by the Admin SDK. Pinning them here closes the self-escalation path.
      allow update: if isSelf(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdAt == existing().createdAt &&
        changed().hasOnly(['name', 'organizationName', 'updatedAt']) &&
        stampedNow();

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------- /organizations

    function isValidOrganization(data) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        isValidId(data.ownerId) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /organizations/{orgId} {
      allow get: if isValidId(orgId) && (isMemberOf(orgId) || isAdmin());
      allow list: if isAdmin();

      // The creator may not have a profile yet, so membership is not required
      // here; self-ownership is.
      allow create: if isSignedIn() &&
        isValidId(orgId) &&
        isValidOrganization(incoming()) &&
        incoming().id == orgId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        stampedNow();

      allow update: if isValidId(orgId) &&
        isValidOrganization(incoming()) &&
        (existing().ownerId == request.auth.uid || isAdmin()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        changed().hasOnly(['name', 'updatedAt']) &&
        stampedNow();

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- /projects

    // Jurisdiction is restricted to US to match the frozen specification. Do
    // not widen this without a corresponding research policy and an ADR.
    function isValidProject(data) {
      return data.keys().hasAll([
          'id', 'organizationId', 'title', 'jurisdiction', 'createdBy',
          'version', 'isRunApproved', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        isValidId(data.organizationId) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.jurisdiction == 'US' &&
        isValidId(data.createdBy) &&
        data.version is int && data.version >= 1 &&
        data.isRunApproved is bool &&
        data.get('budgetUsed', 0) is number &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /projects/{projectId} {

      function canReadProject() {
        return isMemberOf(existing().organizationId) || isAdmin();
      }

      function isSealed() {
        return existing().isRunApproved == true;
      }

      allow get: if isValidId(projectId) && canReadProject();
      allow list: if isValidId(projectId) && canReadProject();

      allow create: if isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().id == projectId &&
        isMemberOf(incoming().organizationId) &&
        incoming().createdBy == request.auth.uid &&
        incoming().isRunApproved == false &&
        incoming().get('budgetUsed', 0) == 0 &&
        incoming().version == 1 &&
        incoming().createdAt == request.time &&
        stampedNow();

      // organizationId, createdBy, createdAt and budgetUsed are server-owned.
      // budgetUsed in particular must never be client-writable or the
      // soft-pause and hard-stop spend caps can be defeated.
      allow update: if isValidId(projectId) &&
        isValidProject(incoming()) &&
        canReadProject() &&
        incoming().id == existing().id &&
        incoming().organizationId == existing().organizationId &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        incoming().get('budgetUsed', 0) == existing().get('budgetUsed', 0) &&
        stampedNow() &&
        (
          isAdmin() ||
          (
            !isSealed() &&
            (
              changed().hasOnly(['title', 'version', 'updatedAt']) ||
              // Sealing a run is a formal legal action reserved for a REVIEWER (Production Counsel) or OWNER.
              (
                (isReviewer() || isOrgOwner()) &&
                changed().hasOnly(['isRunApproved', 'version', 'updatedAt']) &&
                incoming().isRunApproved == true
              )
            )
          )
        );

      allow delete: if isAdmin();

      // ----------------------------------------------- /projects/*/entities

      function projectPath() {
        return /databases/$(database)/documents/projects/$(projectId);
      }

      function parentExists() {
        return exists(projectPath());
      }

      function parent() {
        return get(projectPath()).data;
      }

      // Invariant 4. A sub-resource cannot exist outside a valid parent
      // project that the caller can actually reach.
      function inParentOrg() {
        return parentExists() &&
          (isMemberOf(parent().organizationId) || isAdmin());
      }

      function parentSealed() {
        return parentExists() && parent().isRunApproved == true;
      }

      function isValidClearanceEntity(data) {
        return data.keys().hasAll([
            'id', 'projectId', 'canonicalName', 'type',
            'initialProposedStatus', 'rationale', 'confirmedByProducer',
            'updatedAt']) &&
          isValidId(data.id) &&
          isValidId(data.projectId) &&
          data.canonicalName is string &&
          data.canonicalName.size() > 0 &&
          data.canonicalName.size() <= 200 &&
          data.type in ['PERSON_CHARACTER', 'BRAND_BUSINESS_PRODUCT', 'PRODUCTION_TITLE'] &&
          data.initialProposedStatus in [
            'RESEARCH_CLEARED', 'NEEDS_LICENCE', 'NEEDS_REWRITE',
            'BLOCKED', 'INSUFFICIENT_EVIDENCE'] &&
          data.rationale is string && data.rationale.size() <= 2000 &&
          data.get('rewriteSuggestion', '') is string &&
          data.get('rewriteSuggestion', '').size() <= 1000 &&
          data.get('reviewerNotes', '') is string &&
          data.get('reviewerNotes', '').size() <= 2000 &&
          data.confirmedByProducer is bool &&
          data.updatedAt is timestamp;
      }

      match /entities/{entityId} {
        allow get: if isValidId(projectId) && isValidId(entityId) && inParentOrg();
        allow list: if isValidId(projectId) && inParentOrg();

        // Clearance status is owned by the deterministic evidence gate, never
        // by a client and never by a model. A client-seeded entity therefore
        // starts at INSUFFICIENT_EVIDENCE and unconfirmed; the real status is
        // written by the clearance job through the Admin SDK.
        allow create: if isValidId(projectId) &&
          isValidId(entityId) &&
          isValidClearanceEntity(incoming()) &&
          incoming().id == entityId &&
          incoming().projectId == projectId &&
          inParentOrg() &&
          !parentSealed() &&
          (isProducer() || isOrgOwner() || isAdmin()) &&
          incoming().initialProposedStatus == 'INSUFFICIENT_EVIDENCE' &&
          incoming().confirmedByProducer == false &&
          incoming().get('reviewerNotes', '') == '' &&
          stampedNow();

        // Invariant 5. Role partitioning is derived from the caller's profile
        // role, not from which fields they happen to send.
        allow update: if isValidId(projectId) &&
          isValidId(entityId) &&
          isValidClearanceEntity(incoming()) &&
          inParentOrg() &&
          incoming().id == existing().id &&
          incoming().projectId == existing().projectId &&
          stampedNow() &&
          (
            isAdmin() ||
            (
              !parentSealed() &&
              (
                // PRODUCER confirms entities and proposes rewrites. Never
                // status, never reviewer commentary.
                (
                  (isProducer() || isOrgOwner()) &&
                  changed().hasOnly([
                    'confirmedByProducer', 'canonicalName', 'type',
                    'rewriteSuggestion', 'rationale', 'updatedAt'])
                ) ||
                // REVIEWER writes legal commentary and may override status.
                // Never producer confirmation.
                (
                  (isReviewer() || isOrgOwner()) &&
                  changed().hasOnly([
                    'initialProposedStatus', 'reviewerNotes', 'updatedAt'])
                )
              )
            )
          );

        allow delete: if isAdmin();
      }

      // --------------------------------------------- /projects/*/presence

      // Real-time multi-user presence for production counsel and producers.
      match /presence/{presenceId} {
        allow get, list: if isValidId(projectId) && inParentOrg();
        allow create, update: if isValidId(projectId) && isValidId(presenceId) &&
          inParentOrg() &&
          isSelf(incoming().userId) &&
          incoming().id == presenceId &&
          incoming().keys().hasAll(['id', 'userId', 'userName', 'role', 'activeTab', 'lastActiveAt']) &&
          incoming().lastActiveAt is timestamp;
        allow delete: if isValidId(projectId) && isValidId(presenceId) && inParentOrg() &&
          (resource == null || isSelf(resource.data.userId) || isAdmin());
      }

      // --------------------------------------------- /projects/*/auditLogs

      // Append-only tamper-evident hash-chained audit ledger.
      // Tenant members can append valid hash-chained event records.
      // Update and delete operations are strictly denied by law.
      match /auditLogs/{logId} {
        allow get: if isValidId(projectId) && isValidId(logId) && inParentOrg();
        allow list: if isValidId(projectId) && inParentOrg();
        allow create: if isValidId(projectId) && isValidId(logId) &&
          inParentOrg() &&
          incoming().id == logId &&
          incoming().projectId == projectId &&
          incoming().keys().hasAll([
            'id', 'sequence', 'projectId', 'organizationId', 'actorId',
            'actorRole', 'action', 'previousEntryHash', 'entryHash', 'timestamp'
          ]) &&
          incoming().sequence is int && incoming().sequence >= 0 &&
          incoming().actorRole in ['PRODUCER', 'REVIEWER', 'SYSTEM', 'OWNER'] &&
          incoming().timestamp == request.time;
        allow update, delete: if false;
      }
    }

    // Terminal deny-by-default. Documentation of intent: any path not matched
    // by an allow rule above is already denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
