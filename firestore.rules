rules_version = '2';

// PERMISSA Option A Firestore policy.
//
// The Google AI Studio console does not use the Firestore client SDK. It sends
// Firebase ID tokens to the Cloud Run API, and the API performs all database
// access through the Firebase Admin / Google Cloud server SDK. Server SDK
// access is controlled by IAM and bypasses these client Security Rules.
//
// Until a reviewed browser-direct data contract is introduced, every mobile
// and web client operation is denied. This is intentionally narrower than the
// previous legacy rules, which exposed a data model the running API does not
// use.

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
