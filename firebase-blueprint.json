{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and organization membership.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique Firebase Authentication UID."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "Verified email address."
        },
        "role": {
          "type": "string",
          "enum": ["PRODUCER", "REVIEWER", "OWNER"],
          "description": "Workspace role."
        },
        "organizationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Associated tenant organization ID."
        },
        "organizationName": {
          "type": "string",
          "maxLength": 100,
          "description": "Tenant organization name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of account creation."
        }
      },
      "required": ["id", "name", "email", "role", "organizationId", "createdAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Production studio or legal clearance tenant entity.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Organization identifier."
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "description": "Legal entity name."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of organization owner."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last update."
        }
      },
      "required": ["id", "name", "ownerId", "createdAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Clearance workspace project corresponding to a screenplay production.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UUIDv7 project identifier."
        },
        "organizationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Organization tenant identifier."
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "description": "Screenplay title."
        },
        "jurisdiction": {
          "type": "string",
          "enum": ["US", "UK", "EU", "GLOBAL"],
          "description": "Legal jurisdiction."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of creator."
        },
        "version": {
          "type": "number",
          "description": "Current monotonic schema/aggregate version."
        },
        "isRunApproved": {
          "type": "boolean",
          "description": "Whether the clearance run has been formally approved and sealed."
        },
        "budgetUsed": {
          "type": "number",
          "description": "Cumulative provider budget consumed in USD."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp."
        }
      },
      "required": [
        "id",
        "organizationId",
        "title",
        "jurisdiction",
        "createdBy",
        "version",
        "isRunApproved",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClearanceEntity": {
      "title": "ClearanceEntity",
      "description": "Screenplay entity tracked for legal clearance research and evidence verification.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Entity identifier."
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent project identifier."
        },
        "canonicalName": {
          "type": "string",
          "maxLength": 200,
          "description": "Canonical entity name."
        },
        "type": {
          "type": "string",
          "enum": [
            "PERSON_CHARACTER",
            "BRAND_BUSINESS_PRODUCT",
            "PRODUCTION_TITLE"
          ],
          "description": "Entity taxonomy class."
        },
        "initialProposedStatus": {
          "type": "string",
          "enum": [
            "RESEARCH_CLEARED",
            "NEEDS_LICENCE",
            "NEEDS_REWRITE",
            "BLOCKED",
            "INSUFFICIENT_EVIDENCE"
          ],
          "description": "Deterministic policy status."
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000,
          "description": "Detailed clearance rationale."
        },
        "rewriteSuggestion": {
          "type": "string",
          "maxLength": 1000,
          "description": "Optional script rewrite remedy."
        },
        "confirmedByProducer": {
          "type": "boolean",
          "description": "Producer confirmation prerequisite gate."
        },
        "reviewerNotes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Signed legal reviewer commentary."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of last modification."
        }
      },
      "required": [
        "id",
        "projectId",
        "canonicalName",
        "type",
        "initialProposedStatus",
        "rationale",
        "confirmedByProducer",
        "updatedAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Content-free security and execution audit trace.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UUID audit log identifier."
        },
        "organizationId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Tenant organization."
        },
        "projectId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Project reference."
        },
        "actorId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of acting user or service."
        },
        "action": {
          "type": "string",
          "maxLength": 100,
          "description": "Content-free action name."
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of event."
        }
      },
      "required": ["id", "organizationId", "actorId", "action", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Authenticated user profiles with role and tenant assignment."
    },
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Tenant organizations owning projects and clearance repositories."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Production screenplay projects and clearance state."
    },
    "/projects/{projectId}/entities/{entityId}": {
      "schema": "ClearanceEntity",
      "description": "Discovered screenplay entities with evidence status and reviews."
    },
    "/projects/{projectId}/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Tamper-evident content-free operational audit records."
    }
  }
}
